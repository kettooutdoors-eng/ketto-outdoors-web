<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#1b4332">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} | {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}

    {{ 'archivo-variable.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    <style>
      @font-face {
        font-family: 'Archivo';
        font-style: normal;
        font-weight: 400 800;
        font-display: swap;
        src: url('{{ 'archivo-variable.woff2' | asset_url }}') format('woff2');
      }
    </style>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.classList.remove('no-js');</script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    <a class="skip-link" href="#main-content">Skip to content</a>
    {% section 'header' %}
    <main id="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>
    {% section 'footer' %}
    {% section 'welcome-popup' %}
  </body>
</html>
