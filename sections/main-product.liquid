{%- comment -%}
  The kit page, kept deliberately simple: photo, name, one line, price, and one button.
  STOQ (app embed) takes over the button: "Preorder" while a kit is on a preorder offer,
  or its "Notify me" button when a kit is sold out and not preorderable.
  What's in the box and the setup steps live on the QR sticker page (?view=guide),
  linked from here.
{%- endcomment -%}
{%- liquid
  assign tagline = product.metafields.custom.tagline.value | default: product.description | strip_html | truncatewords: 24
  assign variant = product.selected_or_first_available_variant
-%}
<div class="kit-simple">
  <div class="kit-simple__media" data-gallery>
    {%- if product.featured_media -%}
      {%- assign main_alt = product.featured_media.alt | default: product.title -%}
      <div class="media">
        {{ product.featured_media.preview_image | image_url: width: 1100 | image_tag: alt: main_alt, loading: 'eager', fetchpriority: 'high', class: 'gallery-main' }}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="kit-thumbs">
          {%- for media in product.media -%}
            <button type="button" data-gallery-thumb data-src="{{ media.preview_image | image_url: width: 1100 }}" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="Show photo {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
              {{ media.preview_image | image_url: width: 140 | image_tag: alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      {% render 'media', alt: product.title %}
    {%- endif -%}
  </div>

  <div class="kit-simple__info">
    <h1>{{ product.title }}</h1>
    {%- if tagline != blank -%}<p class="kit-simple__tagline">{{ tagline }}</p>{%- endif -%}
    <div class="price price--lg">{{ variant.price | money_without_trailing_zeros }}</div>

    {%- form 'product', product, class: 'kit-simple__form' -%}
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="return_to" value="/checkout">
      <button type="submit" name="add" class="btn btn--rust btn--block btn--big product-form__submit"{% unless product.available %} disabled{% endunless %}>
        {%- if product.available -%}{{ section.settings.button_label }}{%- else -%}Sold out{%- endif -%}
      </button>
    {%- endform -%}

    {%- if section.settings.note != blank -%}
      <p class="kit-simple__note">{{ section.settings.note }}</p>
    {%- endif -%}
    {%- if section.settings.show_setup_link -%}
      <a class="kit-simple__setup" href="{{ product.url }}?view=guide">How to set it up &rarr;</a>
    {%- endif -%}
  </div>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Kit page",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Buy now", "info": "Shown when the kit is in stock. While a kit is on a STOQ preorder offer, STOQ shows its Preorder button instead." },
    { "type": "text", "id": "note", "label": "Note under the button", "default": "Bring your own rod and reel." },
    { "type": "checkbox", "id": "show_setup_link", "label": "Show \"How to set it up\" link", "default": true, "info": "Opens the same page as the QR sticker in the kit." }
  ]
}
{% endschema %}
