{%- liquid
  assign quiet = false
  if request.page_type == 'cart' or request.page_type == 'policy' or request.page_type == 'password' or request.page_type == 'captcha'
    assign quiet = true
  endif
  assign code = section.settings.code | strip | upcase
  assign shop_url = section.settings.shop_link | default: '/collections/kits'
-%}
{%- if section.settings.enabled and code != blank and quiet == false -%}
  {%- form 'customer', id: 'WelcomeForm' -%}
    {%- assign claimed = form.posted_successfully? -%}
    <div class="modal" data-welcome data-delay="{{ section.settings.delay | times: 1000 }}"{% if claimed %} data-claimed{% else %} hidden{% endif %}>
      <div class="modal__box" role="dialog" aria-modal="true" aria-labelledby="WelcomeHeading">
        <button type="button" class="modal__close" aria-label="Close" data-welcome-close>&times;</button>
        {%- if claimed -%}
          <h2 id="WelcomeHeading">Your code is ready.</h2>
          <p class="muted" style="margin-top: 10px; font-size: 14px;">Use it at checkout for {{ section.settings.percent }}% off your first order.</p>
          <div class="code-box">{{ code }}</div>
          <a class="btn btn--block" href="/discount/{{ code | url_encode }}?redirect={{ shop_url | url_encode }}">Apply my code and shop</a>
        {%- else -%}
          <div class="eyebrow">{{ section.settings.eyebrow }}</div>
          <h2 id="WelcomeHeading">Get {{ section.settings.percent }}% off your first purchase.</h2>
          <p class="muted" style="margin-top: 10px; font-size: 14px;">Enter your email and we'll show you your code.</p>
          <input type="hidden" name="contact[tags]" value="newsletter,welcome-discount">
          <label for="WelcomeEmail" class="visually-hidden">Your email</label>
          <input class="input" type="email" id="WelcomeEmail" name="contact[email]" autocomplete="email" placeholder="you@example.com" required>
          <label class="check">
            <input type="checkbox" required>
            <span>I'd like occasional emails about new gear and fishing tips. Unsubscribe anytime. <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy policy</a></span>
          </label>
          {%- if form.errors -%}
            <p class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          <button type="submit" class="btn btn--rust btn--block">Get my {{ section.settings.percent }}% off</button>
          <button type="button" class="linkish" style="margin-top: 4px; color: var(--ink); opacity: .65; align-self: center;" data-welcome-close>No thanks</button>
          <p style="font-size: 11px; opacity: .55; text-align: center;">{{ section.settings.percent }}% off your first order. One use per customer.</p>
        {%- endif -%}
      </div>
    </div>
  {%- endform -%}
{%- endif -%}

{% schema %}
{
  "name": "Welcome pop-up",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show the welcome pop-up", "default": true },
    { "type": "text", "id": "code", "label": "Discount code", "default": "WELCOME15", "info": "Create this code in Shopify under Discounts, or the pop-up hands out a code that doesn't work." },
    { "type": "number", "id": "percent", "label": "Percent off (shown in the text)", "default": 15 },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Welcome to Ketto" },
    { "type": "range", "id": "delay", "label": "Seconds before it appears", "min": 2, "max": 60, "step": 1, "unit": "s", "default": 8 },
    { "type": "url", "id": "shop_link", "label": "Where 'Apply my code and shop' goes" }
  ]
}
{% endschema %}
