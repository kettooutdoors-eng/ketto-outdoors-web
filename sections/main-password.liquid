<section class="hero" style="min-height: 100vh;">
  <img class="hero__img" src="{{ 'hero-photo.jpg' | asset_url }}" alt="" width="1600" height="1168">
  <div class="hero__shade"></div>
  <div class="hero__panel" style="flex-direction: column; align-items: center; text-align: center; max-width: 560px;">
    <img src="{{ 'ketto-lockup.png' | asset_url }}" alt="{{ shop.name }}" width="210" height="71" style="height: 71px; width: auto;">
    <h1 style="font-size: 40px;">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p style="margin: 0;">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'customer', id: 'PasswordNewsletter', class: 'stack password-news' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,launch-list">
      {%- if form.posted_successfully? -%}
        <p class="form-success">You're on the list. We'll email you when we open.</p>
      {%- else -%}
        <label for="PasswordEmail" class="visually-hidden">Email</label>
        <div style="display: flex; gap: 8px;">
          <input class="input" type="email" id="PasswordEmail" name="contact[email]" autocomplete="email" placeholder="you@example.com" required>
          <button type="submit" class="btn btn--rust">Notify me</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details style="font-size: 13px;">
      <summary style="cursor: pointer; opacity: .7;">Store owner? Enter the password</summary>
      {%- form 'storefront_password', class: 'password-login' -%}
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <label for="StorePassword" class="visually-hidden">Password</label>
        <div style="display: flex; gap: 8px; margin-top: 10px;">
          <input class="input" type="password" id="StorePassword" name="password" autocomplete="current-password" placeholder="Password">
          <button type="submit" class="btn">Enter</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Coming soon",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon." }
  ]
}
{% endschema %}
