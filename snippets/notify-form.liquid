{%- comment -%}
  "Email me when it's back" for a sold-out product. Sends a contact message to the store
  owner's email with the product name, so you know who to tell when it's restocked.
{%- endcomment -%}
{%- form 'contact', id: 'NotifyForm', class: 'stack notify-form' -%}
  {%- if form.posted_successfully? -%}
    <p class="form-success">Got it. We'll email you when {{ product.title }} is back.</p>
  {%- else -%}
    <input type="hidden" name="contact[subject]" value="Back-in-stock request: {{ product.title | escape }}">
    <input type="hidden" name="contact[body]" value="Please email me when {{ product.title | escape }} is back in stock.">
    <label for="NotifyEmail" style="font-size: 13px; font-weight: 700;">Email me when it's back</label>
    <div style="display: flex; gap: 8px;">
      <input class="input" type="email" id="NotifyEmail" name="contact[email]" autocomplete="email" placeholder="you@example.com" required>
      <button type="submit" class="btn">Notify me</button>
    </div>
    {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
  {%- endif -%}
{%- endform -%}
