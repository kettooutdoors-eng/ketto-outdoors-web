{%- liquid
  assign components = product.metafields.custom.kit_components.value
  assign tagline = product.metafields.custom.tagline.value
  assign reassurance = product.metafields.custom.reassurance.value
  assign variant = product.selected_or_first_available_variant
  assign kits_url = section.settings.back_link | default: '/collections/kits'
-%}
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="{{ kits_url }}">{{ section.settings.back_label }}</a> / {{ product.title }}
</nav>

<div class="kit-hero grid-2">
  <div data-gallery>
    {%- if product.featured_media -%}
      {%- assign main_alt = product.featured_media.alt | default: product.title -%}
      <div class="media" style="height: 420px;">
        {{ product.featured_media.preview_image | image_url: width: 1100 | image_tag: alt: main_alt, loading: 'eager', fetchpriority: 'high', class: 'gallery-main' }}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="kit-thumbs">
          {%- for media in product.media -%}
            <button type="button" data-gallery-thumb data-src="{{ media.preview_image | image_url: width: 1100 }}" data-alt="{{ media.alt | default: product.title | escape }}" aria-label="Show photo {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
              {{ media.preview_image | image_url: width: 140 | image_tag: alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- else -%}
      {% render 'media', alt: product.title, height: 420 %}
    {%- endif -%}
  </div>

  <div class="stack">
    {%- if components.size > 0 -%}
      <div class="kicker">{{ components.size }}-piece kit</div>
    {%- endif -%}
    <h1>{{ product.title }}</h1>
    {%- if tagline != blank -%}
      <p style="font-size: 15px; line-height: 1.6;">{{ tagline }}</p>
    {%- endif -%}
    {%- if product.description != blank -%}
      <div class="rte" style="font-size: 14px; line-height: 1.6; opacity: .85;">{{ product.description }}</div>
    {%- endif -%}

    <div style="display: flex; align-items: center; gap: 16px;">
      <span class="price price--lg">{{ variant.price | money_without_trailing_zeros }}</span>
      {%- if variant.compare_at_price > variant.price -%}
        <s class="muted">{{ variant.compare_at_price | money_without_trailing_zeros }}</s>
      {%- endif -%}
      {%- if variant.available -%}
        <span class="stock">In stock</span>
      {%- else -%}
        <span class="stock stock--out">Sold out</span>
      {%- endif -%}
    </div>

    {%- form 'product', product, id: 'ProductForm', class: 'stack product-form' -%}
      {%- if product.has_only_default_variant -%}
        <input type="hidden" name="id" value="{{ variant.id }}">
      {%- else -%}
        <div class="field">
          <label for="ProductVariant">{{ product.options | join: ' / ' }}</label>
          <select id="ProductVariant" name="id" class="input">
            {%- for v in product.variants -%}
              <option value="{{ v.id }}"{% if v == variant %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>
                {{ v.title }}{% unless v.available %} (sold out){% endunless %}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
      <button type="submit" class="btn btn--block"{% unless product.available %} disabled{% endunless %}>
        {%- if product.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
      </button>
      {%- if section.settings.show_dynamic_checkout and product.available -%}
        {{ form | payment_button }}
      {%- endif -%}
    {%- endform -%}

    {%- unless product.available -%}
      {% render 'notify-form', product: product %}
    {%- endunless -%}

    {%- if reassurance != blank -%}
      <div class="note" style="margin-top: 8px;">{{ reassurance | newline_to_br }}</div>
    {%- endif -%}
  </div>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "Kit details (top)",
  "settings": [
    { "type": "text", "id": "back_label", "label": "Breadcrumb label", "default": "Kits" },
    { "type": "url", "id": "back_link", "label": "Breadcrumb link" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show express checkout button (Shop Pay, Apple Pay)", "default": true }
  ]
}
{% endschema %}
