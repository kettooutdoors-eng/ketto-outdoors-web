{%- comment -%} The green page header band, without the page's body text. {%- endcomment -%}
<section class="page-hero">
  {%- if section.settings.eyebrow != blank -%}<div class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</div>{%- endif -%}
  <h1>{{ section.settings.heading | default: page.title }}</h1>
  {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
</section>

{% schema %}
{
  "name": "Page header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page's title." },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Page header" }]
}
{% endschema %}
