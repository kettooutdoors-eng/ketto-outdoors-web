<section class="page-hero">
  <h1>Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" style="display: flex; gap: 8px; max-width: 480px; margin: 20px auto 0;">
    <label for="SearchPageInput" class="visually-hidden">Search</label>
    <input class="input" type="search" id="SearchPageInput" name="q" value="{{ search.terms | escape }}" placeholder="Search kits, guides, and posts">
    <button type="submit" class="btn btn--rust">Go</button>
  </form>
</section>

<div class="narrow" style="max-width: 800px;">
  {%- if search.performed -%}
    <p class="muted" style="margin-bottom: 20px;">{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }} for "{{ search.terms | escape }}"</p>
    {%- paginate search.results by 20 -%}
      <div class="stack">
        {%- for item in search.results -%}
          <a href="{{ item.url }}" class="card card--sm" style="padding: 18px 20px; color: var(--ink);">
            <div class="kicker">{{ item.object_type | replace: 'article', 'Post' | replace: 'product', 'Kit' | replace: 'page', 'Page' }}</div>
            <div style="font-weight: 800; font-size: 17px; margin-top: 4px;">{{ item.title }}</div>
            {%- if item.object_type == 'product' -%}
              <div style="font-size: 14px; margin-top: 4px;">{{ item.price | money_without_trailing_zeros }}</div>
            {%- endif -%}
          </a>
        {%- else -%}
          <p>Nothing matched. Try a simpler word, or <a href="{{ routes.collections_url }}/kits">see the kits</a>.</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="center" style="margin-top: 28px;">{{ paginate | default_pagination }}</div>{%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}
