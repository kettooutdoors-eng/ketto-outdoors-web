{%- comment -%}
  The rigging guide for a kit (product URL + ?view=guide), opened by the QR sticker
  in the box and the "How to set it up" link on the kit page: setup video and steps.
{%- endcomment -%}
{%- liquid
  assign steps = product.metafields.custom.setup_steps.value
  assign setup_note = product.metafields.custom.setup_note.value
  assign video = product.metafields.custom.setup_video.value
  assign email = section.settings.email | default: shop.email
-%}
<section class="page-hero" style="padding: 44px 24px 40px;">
  <div class="eyebrow eyebrow--light">How to rig it</div>
  <h1 style="font-size: 36px;">{{ product.title }}</h1>
  <p style="max-width: 38ch; font-size: 16px;">Step-by-step setup, from tying on to your first cast.</p>
  <div style="margin-top: 24px;">
    {%- if video != blank -%}
      <a href="{{ video }}" class="btn btn--rust" style="padding: 16px 28px; font-size: 15px;">Watch the setup video</a>
    {%- else -%}
      <div style="display: inline-block; padding: 12px 22px; background: rgba(243,239,227,.15); color: var(--cream); font-size: 14px; font-weight: 700;">Setup video coming soon</div>
    {%- endif -%}
  </div>
</section>

{%- if steps.size > 0 -%}
  <section style="max-width: 640px; margin: 0 auto; padding: 40px 20px 8px;">
    <h2 style="font-size: 26px; margin-bottom: 6px;">Rig it step by step</h2>
    {%- if setup_note != blank -%}
      <p style="font-size: 15px; line-height: 1.55; opacity: .8; margin-bottom: 22px;">{{ setup_note }}</p>
    {%- endif -%}
    <ol class="steps" style="gap: 18px;">
      {%- for step in steps -%}
        <li class="step" style="gap: 14px;">
          <span class="step__num">{{ forloop.index }}</span>
          <div>
            <div class="step__title" style="font-size: 17px;">{{ step.title }}</div>
            <p style="font-size: 15px; line-height: 1.6;">{{ step.detail }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </section>
{%- endif -%}

<section style="max-width: 640px; margin: 0 auto; padding: 40px 20px 56px;">
  <div class="note" style="padding: 20px 22px;">
    <div style="font-weight: 800; font-size: 17px;">Questions?</div>
    <p style="font-size: 15px; line-height: 1.55; margin-top: 6px;">
      Email us at <a href="mailto:{{ email }}" style="font-weight: 700;">{{ email }}</a> and we'll help.
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Kit sticker page",
  "settings": [
    { "type": "paragraph", "content": "Opened by the QR sticker in each kit. Set each kit's setup video in Shopify admin under Products > (kit) > Metafields > Setup video." },
    { "type": "text", "id": "email", "label": "Help email", "default": "KettoOutdoors@gmail.com" }
  ]
}
{% endschema %}
