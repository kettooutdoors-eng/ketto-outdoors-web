{%- comment -%}
  "Get notified" pop-up. It asks for an email, tags the new customer `newsletter,kit-notify`
  so you can find everyone who wants to hear when kits are in stock, and says thanks. No
  discount code. It appears after the delay set below (20 seconds by default).
{%- endcomment -%}
{%- liquid
  assign quiet = false
  if request.page_type == 'cart' or request.page_type == 'policy' or request.page_type == 'password' or request.page_type == 'captcha'
    assign quiet = true
  endif
-%}
{%- if section.settings.enabled and quiet == false -%}
  {%- form 'customer', id: 'WelcomeForm' -%}
    {%- assign claimed = form.posted_successfully? -%}
    <div class="modal" data-welcome data-delay="{{ section.settings.delay | times: 1000 }}"{% if claimed %} data-claimed{% else %} hidden{% endif %}>
      <div class="modal__box" role="dialog" aria-modal="true" aria-labelledby="WelcomeHeading">
        <button type="button" class="modal__close" aria-label="Close" data-welcome-close>&times;</button>
        {%- if claimed -%}
          <h2 id="WelcomeHeading">You're on the list.</h2>
          <p class="welcome__lede">{{ section.settings.thanks_text }}</p>
          <button type="button" class="btn btn--block" style="margin-top: 24px;" data-welcome-close>Close</button>
        {%- else -%}
          <div class="eyebrow">{{ section.settings.eyebrow }}</div>
          <h2 id="WelcomeHeading">{{ section.settings.heading }}</h2>
          <p class="welcome__lede">{{ section.settings.text }}</p>
          <div class="welcome__fields">
            <input type="hidden" name="contact[tags]" value="newsletter,kit-notify">
            <label for="WelcomeEmail" class="visually-hidden">Your email</label>
            <input class="input welcome__input" type="email" id="WelcomeEmail" name="contact[email]" autocomplete="email" placeholder="you@example.com" required>
            <label class="check welcome__check">
              <input type="checkbox" required>
              <span>Email me when kits are in stock, plus occasional fishing tips. Unsubscribe anytime. <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy policy</a></span>
            </label>
            {%- if form.errors -%}
              <p class="form-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
            <button type="submit" class="btn btn--rust btn--block welcome__submit">{{ section.settings.button_label }}</button>
          </div>
          <button type="button" class="linkish welcome__skip" data-welcome-close>No thanks</button>
          <p class="welcome__fine">{{ section.settings.fine_print }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endform -%}
{%- endif -%}

{% schema %}
{
  "name": "Get notified pop-up",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show the pop-up", "default": true },
    { "type": "range", "id": "delay", "label": "Seconds before it appears", "min": 2, "max": 60, "step": 1, "unit": "s", "default": 20 },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Kits are coming" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get notified when kits are in stock." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Enter your email and we'll let you know the moment your kit is ready. Nothing to pay." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "We'll only email you about kits and fishing tips." },
    { "type": "textarea", "id": "thanks_text", "label": "Thank-you text", "default": "We'll email you as soon as kits are in stock. Nothing to pay and nothing more to do." }
  ]
}
{% endschema %}
