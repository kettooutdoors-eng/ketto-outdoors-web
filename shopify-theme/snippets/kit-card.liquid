{%- comment -%}
  A kit in a grid: photo, piece count, name, tagline, price, Buy now, View the kit.
  Usage: {% render 'kit-card', product: product %}
{%- endcomment -%}
{%- liquid
  assign components = product.metafields.custom.kit_components.value
  assign tagline = product.metafields.custom.tagline.value | default: product.description | strip_html | truncatewords: 22
  assign variant = product.selected_or_first_available_variant
-%}
<div class="card card--lg card-lift kit-card">
  {% render 'media', image: product.featured_image, alt: product.title, width: 600 %}
  {%- if components.size > 0 -%}
    <span class="pill">{{ components.size }}-piece kit</span>
  {%- endif -%}
  <a href="{{ product.url }}" class="kit-card__title">{{ product.title }}</a>
  {%- if tagline != blank -%}<p style="font-size: 14px;">{{ tagline }}</p>{%- endif -%}
  <div class="price">{{ product.price | money_without_trailing_zeros }}</div>
  <div class="kit-card__actions">
    {%- form 'product', product, class: 'kit-card__form' -%}
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="return_to" value="/checkout">
      <button type="submit" class="btn btn--rust btn--block btn--big"{% unless product.available %} disabled{% endunless %}>
        {%- if product.available -%}Buy now{%- else -%}Sold out{%- endif -%}
      </button>
    {%- endform -%}
    <a href="{{ product.url }}" class="btn btn--block">View the kit</a>
  </div>
</div>
